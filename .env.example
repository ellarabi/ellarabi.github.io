# Copy to .env (never commit .env). Only needed if you don't use `npm run login`.
# Token: Cloudflare dashboard -> My Profile -> API Tokens -> Create token
#        -> "Edit Cloudflare Workers" template, or custom with "Account > Cloudflare Pages > Edit".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: override the Pages project name (default: ellarbi)
# CF_PAGES_PROJECT=ellarbi
